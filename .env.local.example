# Supabase, the SAME project the legacy admin app (chey-music) writes to.
# Copy this file to `.env.local` and fill in the real values.
#
# Both are safe to expose to the browser: every table this site reads is
# guarded by RLS (public SELECT on published content, admin-only writes).
# Find them in the Supabase dashboard under Project Settings → API.
#
# Set these in the deploy host too, not just locally. They are inlined at
# build time, so a build without them silently serves the static fallback,
# the site looks fine while being stale. Check the build log for
# "[loaders] … using static content".

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
